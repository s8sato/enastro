{
  "name": "enastro",
  "version": "0.3.4",
  "private": true,
  "license": "Apache-2.0",
  "description": "enastro: publish selected notes from an Obsidian vault as a static, privacy-safe knowledge graph site.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "enastro": "bin/enastro.mjs"
  },
  "files": [
    "bin",
    "dist-ts"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc && node scripts/copy-client-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:benchmark-vault": "node scripts/generate-benchmark-vault.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "d3-force": "^3.0.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "pixi.js": "^8.22.0",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.9.1"
  }
}
