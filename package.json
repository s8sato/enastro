{
  "name": "enastro",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "enastro: publish selected notes from an Obsidian vault as a static, privacy-safe knowledge graph site.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "enastro": "bin/enastro.mjs"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-client-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:benchmark-vault": "node scripts/generate-benchmark-vault.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "pixi.js": "^8.20.0",
    "sanitize-html": "^2.17.7",
    "yaml": "^2.6.0"
  }
}
